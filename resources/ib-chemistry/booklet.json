    {
      "id": "arrhenius",
      "title": "Temperature and rate (AHL)",
      "pdf_page": 6,
      "section": "section 1",
      "note": "Use natural logarithms and kelvin; express Eₐ in J mol⁻¹ with R in J K⁻¹ mol⁻¹.",
      "formula": "ln k = ln A − Eₐ/(RT)"
    },
    {
      "id": "equilibrium-energy",
      "title": "Equilibrium and energy (AHL)",
      "pdf_page": 6,
      "section": "section 1",
      "note": "This is an AHL connection. The SL equilibrium expression still comes from the balanced equation.",
      "formula": "ΔG° = −RT ln K"
    },
